<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SSACO - Game Archive</title>
  
  <link href='https://fonts.googleapis.com/css?family=Lato:400,700,300|Open+Sans:400,600,700,300' rel='stylesheet' type='text/css'>
  <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css">
  <link rel="stylesheet" type="text/css" href="css/font-awesome.min.css">
  <link rel="stylesheet" type="text/css" href="css/style.css">

  <style>
    /* ?�체 배경 ?��? 계열 ?�정 */
    body { background-color: #ffffff; }

    #all-games-section { padding: 80px 0; }

    .archive-title {
      text-align: center;
      font-weight: 700;
      font-size: 32px;
      color: #222;
      text-transform: uppercase;
      margin-bottom: 60px;
      position: relative;
    }

    /* ?�?��? ?�래 ?�렌지??강조??*/
    .archive-title::after {
      content: '';
      position: absolute;
      width: 60px;
      height: 3px;
      background: #FF8C00;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
    }

    /* 가로형 3??그리??(게임??많아지�??�동?�로 ?�음 줄로 ?�어�? */
    .game-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }

    .game-card {
      background-color: #fff;
      border-radius: 4px;
      overflow: hidden;
      transition: all 0.3s ease;
      border: 1px solid #eee;
    }

    .game-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      border-color: #FF8C00;
    }

    .game-thumb {
      width: 100%;
      height: 200px;
      object-fit: cover;
      background-color: #f5f5f5;
    }

    .card-content { padding: 25px; }

    .card-content h3 {
      margin-top: 0;
      font-weight: 700;
      font-size: 20px;
      color: #222;
    }

    .card-content p {
      color: #777;
      font-size: 14px;
      height: 4.2em;
      overflow: hidden;
      line-height: 1.4;
      margin-bottom: 20px;
    }

    .tag {
      font-size: 12px;
      color: #FF8C00;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 10px;
    }

    /* ?�렌지??버튼 ?�정 */
    .download-btn {
      display: block;
      width: 100%;
      padding: 12px 0;
      background-color: #FF8C00;
      color: #ffffff !important;
      font-weight: 700;
      text-align: center;
      border-radius: 2px;
      text-decoration: none !important;
      transition: background 0.3s;
    }

    .download-btn:hover { background-color: #FF8C00; }

    .header-spacer { height: 100px; }
      .navbar-default { background-color: rgba(0, 0, 0, 0.8) !important; padding: 25px 0 !important; }
    .main-header, .bg-color { min-height: auto !important; height: 90px !important; }
</style>
</head>

